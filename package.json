        "eslint-config-next": "14.2.14",
        "jest": "^30.2.0",
        "postcss": "8.4.47",
        "tailwindcss": "3.4.13",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "5.5.4"
    }
