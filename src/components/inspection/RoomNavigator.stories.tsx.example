import type { Meta, StoryObj } from '@storybook/react'
import { useState } from 'react'
import { RoomNavigator, RoomItem } from './RoomNavigator'

/**
 * RoomNavigator Component Stories
 *
 * The RoomNavigator is a sidebar component for navigating between rooms
 * during an inspection. It displays room status counts, supports search
 * filtering, and provides full keyboard navigation.
 *
 * ## Features
 * - Visual status indicators (critical, issue, skipped, pending, good)
 * - Search with case-insensitive filtering
 * - Keyboard navigation (Arrow keys, Enter, Space, Home, End)
 * - ARIA labels for accessibility
 * - Focus management
 * - Outstanding items badge
 */

const meta: Meta<typeof RoomNavigator> = {
  title: 'Inspection/RoomNavigator',
  component: RoomNavigator,
  parameters: {
    layout: 'fullscreen',
  },
  tags: ['autodocs'],
  argTypes: {
    rooms: {
      description: 'Array of rooms with status counts',
      control: 'object',
    },
    activeRoomId: {
      description: 'Currently active room ID',
      control: 'text',
    },
    onSelectRoom: {
      description: 'Callback when room is selected',
      action: 'room selected',
    },
    searchTerm: {
      description: 'Current search term',
      control: 'text',
    },
    onSearch: {
      description: 'Callback when search term changes',
      action: 'search changed',
    },
  },
}

export default meta
type Story = StoryObj<typeof RoomNavigator>

