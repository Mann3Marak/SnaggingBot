      good: 3,
      issue: 1,
      critical: 1,
      skipped: 0,
      notApplicable: 0,
      pending: 2,
    },
  },
  {
    roomId: 'bathroom',
    label: 'Bathroom',
    counts: {
      good: 10,
      issue: 0,
      critical: 0,
      skipped: 0,
      notApplicable: 0,
      pending: 0,
    },
  },
  {
    roomId: 'balcony',
    label: 'Balcony',
    counts: {
      good: 0,
      issue: 0,
      critical: 0,
      skipped: 0,
      notApplicable: 3,
      pending: 0,
    },
  },
]

const manyRooms: RoomItem[] = [
  ...defaultRooms,
  {
    roomId: 'bedroom-2',
    label: 'Bedroom 2',
    counts: { good: 5, issue: 1, critical: 0, skipped: 0, notApplicable: 0, pending: 1 },
  },
  {
    roomId: 'bedroom-3',
    label: 'Bedroom 3',
    counts: { good: 4, issue: 2, critical: 0, skipped: 1, notApplicable: 0, pending: 0 },
  },
  {
    roomId: 'hallway',
    label: 'Hallway',
    counts: { good: 3, issue: 0, critical: 0, skipped: 0, notApplicable: 0, pending: 2 },
  },
  {
    roomId: 'storage',
    label: 'Storage',
    counts: { good: 2, issue: 0, critical: 0, skipped: 0, notApplicable: 1, pending: 0 },
  },
