import type { Meta, StoryObj } from '@storybook/react'
import { RoomItemList, Item, StatusCounts } from './RoomItemList'

/**
 * RoomItemList Component Stories
 *
 * Displays a list of inspection items for a selected room with:
 * - Status badges (good, issue, critical, skipped, not_applicable, pending)
 * - Active item highlighting
 * - Sticky header with room name and status summary
 * - "Jump to next pending" quick navigation
 * - Item selection callbacks
 *
 * To enable these stories:
 * 1. Install Storybook: npm install --save-dev @storybook/react @storybook/nextjs
 * 2. Rename this file to RoomItemList.stories.tsx
 * 3. Run: npm run storybook
 */

const meta = {
  title: 'Inspection/RoomItemList',
  component: RoomItemList,
  parameters: {
    layout: 'fullscreen',
  },
  tags: ['autodocs'],
  argTypes: {
    onSelectItem: { action: 'item-selected' },
    onJumpNextPending: { action: 'jump-to-pending' },
  },
} satisfies Meta<typeof RoomItemList>

export default meta
type Story = StoryObj<typeof meta>

// ==================== MOCK DATA ====================

const kitchenItems: Item[] = [
  { id: '1', label: 'Check cabinet doors align properly', status: 'good', order: 1 },
  { id: '2', label: 'Inspect countertop for damage', status: 'good', order: 2 },
  { id: '3', label: 'Test all faucets for leaks', status: 'issue', order: 3 },
  { id: '4', label: 'Check sink drainage', status: 'good', order: 4 },
  { id: '5', label: 'Inspect appliance installation', status: 'critical', order: 5 },
  { id: '6', label: 'Check electrical outlets', status: 'pending', order: 6 },
  { id: '7', label: 'Inspect flooring condition', status: 'pending', order: 7 },
]

const kitchenCounts: StatusCounts = {
  good: 3,
  issue: 1,
  critical: 1,
  skipped: 0,
  notApplicable: 0,
  pending: 2,
}

