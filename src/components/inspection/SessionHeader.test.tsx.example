import { render, screen } from '@testing-library/react'
import { SessionHeader, StatusCounts } from './SessionHeader'

/**
 * SessionHeader Component Unit Tests
 *
 * To enable these tests:
 * 1. Install dependencies:
 *    npm install --save-dev jest @testing-library/react @testing-library/jest-dom
 * 2. Configure Jest for Next.js (create jest.config.js)
 * 3. Rename this file to SessionHeader.test.tsx
 * 4. Run: npm test SessionHeader
 */

// ==================== MOCK DATA ====================

const mockCounts: StatusCounts = {
  good: 10,
  issue: 3,
  critical: 2,
  skipped: 1,
  notApplicable: 4,
  pending: 15,
}

const defaultProps = {
  projectName: 'Test Project',
  apartmentNumber: 'A-101',
  inspectorName: 'John Doe',
  lastUpdated: new Date(),
  counts: mockCounts,
  activeRoomLabel: 'Kitchen',
  activeItemLabel: 'Check cabinet doors',
}

// ==================== TESTS ====================

describe('SessionHeader', () => {
  // ==================== RENDERING ====================

  describe('Rendering', () => {
    test('renders project name', () => {
      render(<SessionHeader {...defaultProps} />)
      expect(screen.getByText('Test Project')).toBeInTheDocument()
    })

    test('renders apartment number', () => {
      render(<SessionHeader {...defaultProps} />)
      expect(screen.getByText('A-101')).toBeInTheDocument()
    })

    test('renders inspector name', () => {
      render(<SessionHeader {...defaultProps} />)
      expect(screen.getByText('John Doe')).toBeInTheDocument()
    })

    test('renders active room and item', () => {
      render(<SessionHeader {...defaultProps} />)
      expect(screen.getByText('Kitchen')).toBeInTheDocument()
      expect(screen.getByText('Check cabinet doors')).toBeInTheDocument()
    })

    test('renders "No active item selected" when no active item', () => {
      render(
        <SessionHeader
          {...defaultProps}
          activeRoomLabel={null}
          activeItemLabel={null}
        />
      )
      expect(screen.getByText('No active item selected')).toBeInTheDocument()
    })

    test('renders header element with correct role', () => {
      const { container } = render(<SessionHeader {...defaultProps} />)
      const header = container.querySelector('header')
      expect(header).toBeInTheDocument()
    })
  })

  // ==================== TIMESTAMP FORMATTING ====================

  describe('Timestamp Formatting', () => {
    test('formats "just now" for current time', () => {
      render(<SessionHeader {...defaultProps} lastUpdated={new Date()} />)
      expect(screen.getByText(/just now/i)).toBeInTheDocument()
    })

    test('formats minutes ago correctly (singular)', () => {
      const oneMinuteAgo = new Date(Date.now() - 60000)
      render(<SessionHeader {...defaultProps} lastUpdated={oneMinuteAgo} />)
      expect(screen.getByText(/1 minute ago/i)).toBeInTheDocument()
    })

    test('formats minutes ago correctly (plural)', () => {
      const fiveMinutesAgo = new Date(Date.now() - 5 * 60000)
      render(<SessionHeader {...defaultProps} lastUpdated={fiveMinutesAgo} />)
      expect(screen.getByText(/5 minutes ago/i)).toBeInTheDocument()
    })

    test('formats hours ago correctly (singular)', () => {
      const oneHourAgo = new Date(Date.now() - 3600000)
      render(<SessionHeader {...defaultProps} lastUpdated={oneHourAgo} />)
      expect(screen.getByText(/1 hour ago/i)).toBeInTheDocument()
    })

    test('formats hours ago correctly (plural)', () => {
      const threeHoursAgo = new Date(Date.now() - 3 * 3600000)
      render(<SessionHeader {...defaultProps} lastUpdated={threeHoursAgo} />)
      expect(screen.getByText(/3 hours ago/i)).toBeInTheDocument()
    })

    test('formats days ago correctly (singular)', () => {
      const oneDayAgo = new Date(Date.now() - 86400000)
      render(<SessionHeader {...defaultProps} lastUpdated={oneDayAgo} />)
      expect(screen.getByText(/1 day ago/i)).toBeInTheDocument()
    })

    test('formats days ago correctly (plural)', () => {
      const threeDaysAgo = new Date(Date.now() - 3 * 86400000)
      render(<SessionHeader {...defaultProps} lastUpdated={threeDaysAgo} />)
      expect(screen.getByText(/3 days ago/i)).toBeInTheDocument()
    })

    test('formats old dates as absolute time', () => {
      const tenDaysAgo = new Date(Date.now() - 10 * 86400000)
      render(<SessionHeader {...defaultProps} lastUpdated={tenDaysAgo} />)
      // Should contain formatted date (e.g., "Nov 5")
      const lastUpdatedText = screen.getByText(/Last updated/)
      expect(lastUpdatedText).toBeInTheDocument()
    })

    test('accepts string dates', () => {
      const dateString = new Date(Date.now() - 5 * 60000).toISOString()
      render(<SessionHeader {...defaultProps} lastUpdated={dateString} />)
      expect(screen.getByText(/5 minutes ago/i)).toBeInTheDocument()
    })
  })

  // ==================== PROGRESS CALCULATION ====================

  describe('Progress Calculation', () => {
    test('calculates completed count correctly', () => {
      // mockCounts: good=10, issue=3, critical=2, skipped=1, notApplicable=4, pending=15
      // completed = 10 + 3 + 2 + 1 + 4 = 20
      render(<SessionHeader {...defaultProps} />)
      expect(screen.getByText(/20\/35/)).toBeInTheDocument() // 20 out of 35 total
    })

    test('calculates total count correctly', () => {
      // total = 10 + 3 + 2 + 1 + 4 + 15 = 35
      render(<SessionHeader {...defaultProps} />)
      expect(screen.getByText(/20\/35/)).toBeInTheDocument()
    })

    test('calculates percentage correctly', () => {
      // 20/35 = 57.14% ≈ 57%
      render(<SessionHeader {...defaultProps} />)
      expect(screen.getByText('57%')).toBeInTheDocument()
    })

    test('shows 100% for completed inspection', () => {
      const completedCounts: StatusCounts = {
        good: 30,
        issue: 5,
        critical: 0,
        skipped: 0,
        notApplicable: 0,
        pending: 0,
      }
      render(<SessionHeader {...defaultProps} counts={completedCounts} />)
      expect(screen.getByText('100%')).toBeInTheDocument()
      expect(screen.getByText(/35\/35/)).toBeInTheDocument()
    })

    test('shows 0% for all pending', () => {
      const allPendingCounts: StatusCounts = {
        good: 0,
        issue: 0,
        critical: 0,
        skipped: 0,
        notApplicable: 0,
        pending: 50,
      }
      render(<SessionHeader {...defaultProps} counts={allPendingCounts} />)
      expect(screen.getByText('0%')).toBeInTheDocument()
      expect(screen.getByText(/0\/50/)).toBeInTheDocument()
    })
  })

  // ==================== STATUS CHIPS ====================

  describe('Status Chips', () => {
    test('displays all status chips with correct counts', () => {
      render(<SessionHeader {...defaultProps} />)
      expect(screen.getByText(/Good: 10/)).toBeInTheDocument()
      expect(screen.getByText(/Issue: 3/)).toBeInTheDocument()
      expect(screen.getByText(/Critical: 2/)).toBeInTheDocument()
      expect(screen.getByText(/Pending: 15/)).toBeInTheDocument()
      expect(screen.getByText(/Skipped: 1/)).toBeInTheDocument()
      expect(screen.getByText(/N\/A: 4/)).toBeInTheDocument()
    })

    test('does not display chips with zero counts', () => {
      const zeroCounts: StatusCounts = {
        good: 10,
        issue: 0,
        critical: 0,
        skipped: 0,
        notApplicable: 0,
        pending: 5,
      }
      render(<SessionHeader {...defaultProps} counts={zeroCounts} />)
      expect(screen.getByText(/Good: 10/)).toBeInTheDocument()
      expect(screen.getByText(/Pending: 5/)).toBeInTheDocument()
      expect(screen.queryByText(/Issue:/)).not.toBeInTheDocument()
      expect(screen.queryByText(/Critical:/)).not.toBeInTheDocument()
      expect(screen.queryByText(/Skipped:/)).not.toBeInTheDocument()
      expect(screen.queryByText(/N\/A:/)).not.toBeInTheDocument()
    })

    test('chips have status role for accessibility', () => {
      render(<SessionHeader {...defaultProps} />)
      const chips = screen.getAllByRole('status')
      expect(chips.length).toBeGreaterThan(0)
    })

    test('chips have aria-labels', () => {
      render(<SessionHeader {...defaultProps} />)
      expect(screen.getByLabelText('10 items marked as good')).toBeInTheDocument()
      expect(screen.getByLabelText('3 items with issues')).toBeInTheDocument()
      expect(screen.getByLabelText('2 critical items')).toBeInTheDocument()
    })
  })

  // ==================== LAST UPDATED BY ====================

  describe('Last Updated By', () => {
    test('displays "Updated by" when lastUpdatedBy is provided', () => {
      render(<SessionHeader {...defaultProps} lastUpdatedBy="Jane Smith" />)
      expect(screen.getByText(/Updated by/)).toBeInTheDocument()
      expect(screen.getByText('Jane Smith')).toBeInTheDocument()
    })

    test('displays time when lastUpdatedBy is provided', () => {
      const fixedTime = new Date('2024-01-15T14:30:00')
      render(
        <SessionHeader
          {...defaultProps}
          lastUpdated={fixedTime}
          lastUpdatedBy="Jane Smith"
        />
      )
      expect(screen.getByText(/at/)).toBeInTheDocument()
      expect(screen.getByText(/14:30/)).toBeInTheDocument()
    })

    test('displays "Last updated" when lastUpdatedBy is not provided', () => {
      render(<SessionHeader {...defaultProps} lastUpdatedBy={undefined} />)
      expect(screen.getByText(/Last updated/)).toBeInTheDocument()
      expect(screen.queryByText(/Updated by/)).not.toBeInTheDocument()
    })
  })

  // ==================== ACTIVE ITEM DISPLAY ====================

  describe('Active Item Display', () => {
    test('displays active item with room and label', () => {
      render(<SessionHeader {...defaultProps} />)
      expect(screen.getByText('Active item:')).toBeInTheDocument()
      expect(screen.getByText('Kitchen')).toBeInTheDocument()
      expect(screen.getByText('Check cabinet doors')).toBeInTheDocument()
    })

    test('displays separator bullet between room and item', () => {
      const { container } = render(<SessionHeader {...defaultProps} />)
      expect(container.textContent).toContain('•')
    })

    test('displays "No active item selected" when both room and item are null', () => {
      render(
        <SessionHeader
          {...defaultProps}
          activeRoomLabel={null}
          activeItemLabel={null}
        />
      )
      expect(screen.getByText('No active item selected')).toBeInTheDocument()
    })

    test('displays "No active item selected" when room is provided but item is null', () => {
      render(
        <SessionHeader
          {...defaultProps}
          activeRoomLabel="Kitchen"
          activeItemLabel={null}
        />
      )
      expect(screen.getByText('No active item selected')).toBeInTheDocument()
    })

    test('displays "No active item selected" when item is provided but room is null', () => {
      render(
        <SessionHeader
          {...defaultProps}
          activeRoomLabel={null}
          activeItemLabel="Check doors"
        />
      )
      expect(screen.getByText('No active item selected')).toBeInTheDocument()
    })
  })

  // ==================== EDGE CASES ====================

  describe('Edge Cases', () => {
    test('handles empty counts (all zeros)', () => {
      const emptyCounts: StatusCounts = {
        good: 0,
        issue: 0,
        critical: 0,
        skipped: 0,
        notApplicable: 0,
        pending: 0,
      }
      render(<SessionHeader {...defaultProps} counts={emptyCounts} />)
      expect(screen.getByText('0/0')).toBeInTheDocument()
      expect(screen.getByText('0%')).toBeInTheDocument()
    })

    test('handles very long project name', () => {
      const longName = 'The Grand Metropolitan Luxury Residential Development Phase 3'
      render(<SessionHeader {...defaultProps} projectName={longName} />)
      expect(screen.getByText(longName)).toBeInTheDocument()
    })

    test('handles very long apartment number', () => {
      const longAptNum = 'TOWER-A-PENTHOUSE-2001-UNIT-B'
      render(<SessionHeader {...defaultProps} apartmentNumber={longAptNum} />)
      expect(screen.getByText(longAptNum)).toBeInTheDocument()
    })

    test('handles very long inspector name', () => {
      const longName = 'Alexandra Rodriguez-Smith-Thompson-Williams'
      render(<SessionHeader {...defaultProps} inspectorName={longName} />)
      expect(screen.getByText(longName)).toBeInTheDocument()
    })

    test('handles very long active item label', () => {
      const longLabel =
        'Inspect custom built-in shelving unit alignment and finish quality including all hardware'
      render(<SessionHeader {...defaultProps} activeItemLabel={longLabel} />)
      expect(screen.getByText(longLabel)).toBeInTheDocument()
    })

    test('handles single item inspection', () => {
      const singleItemCounts: StatusCounts = {
        good: 1,
        issue: 0,
        critical: 0,
        skipped: 0,
        notApplicable: 0,
        pending: 0,
      }
      render(<SessionHeader {...defaultProps} counts={singleItemCounts} />)
      expect(screen.getByText('1/1')).toBeInTheDocument()
      expect(screen.getByText('100%')).toBeInTheDocument()
    })

    test('handles large item counts', () => {
      const largeCounts: StatusCounts = {
        good: 250,
        issue: 50,
        critical: 10,
        skipped: 30,
        notApplicable: 40,
        pending: 120,
      }
      render(<SessionHeader {...defaultProps} counts={largeCounts} />)
      expect(screen.getByText('380/500')).toBeInTheDocument()
    })
  })

  // ==================== RESPONSIVE DESIGN ====================

  describe('Responsive Design', () => {
    test('applies responsive classes for mobile layout', () => {
      const { container } = render(<SessionHeader {...defaultProps} />)
      // Check for flex-col and md:flex-row classes
      const flexElements = container.querySelectorAll('.md\\:flex-row')
      expect(flexElements.length).toBeGreaterThan(0)
    })

    test('renders all content in mobile view', () => {
      // Set viewport to mobile
      global.innerWidth = 375
      render(<SessionHeader {...defaultProps} />)

      // All content should still be present
      expect(screen.getByText('Test Project')).toBeInTheDocument()
      expect(screen.getByText('A-101')).toBeInTheDocument()
      expect(screen.getByText(/Good: 10/)).toBeInTheDocument()
      expect(screen.getByText('Kitchen')).toBeInTheDocument()
    })
  })

  // ==================== ACCESSIBILITY ====================

  describe('Accessibility', () => {
    test('header has correct semantic element', () => {
      const { container } = render(<SessionHeader {...defaultProps} />)
      const header = container.querySelector('header')
      expect(header).toBeInTheDocument()
    })

    test('project name uses h1 heading', () => {
      render(<SessionHeader {...defaultProps} />)
      const heading = screen.getByRole('heading', { level: 1 })
      expect(heading).toHaveTextContent('Test Project')
    })

    test('status chips have role="status"', () => {
      render(<SessionHeader {...defaultProps} />)
      const statusElements = screen.getAllByRole('status')
      expect(statusElements.length).toBe(6) // All 6 status types
    })

    test('status chips have descriptive aria-labels', () => {
      render(<SessionHeader {...defaultProps} />)
      expect(screen.getByLabelText(/items marked as good/)).toBeInTheDocument()
      expect(screen.getByLabelText(/items with issues/)).toBeInTheDocument()
      expect(screen.getByLabelText(/critical items/)).toBeInTheDocument()
    })

    test('icons are hidden from screen readers with aria-hidden', () => {
      const { container } = render(<SessionHeader {...defaultProps} />)
      const hiddenIcons = container.querySelectorAll('[aria-hidden="true"]')
      expect(hiddenIcons.length).toBeGreaterThan(0)
    })
  })

  // ==================== SNAPSHOT ====================

  describe('Snapshot', () => {
    test('matches snapshot for default state', () => {
      const { container } = render(<SessionHeader {...defaultProps} />)
      expect(container).toMatchSnapshot()
    })

    test('matches snapshot with lastUpdatedBy', () => {
      const { container } = render(
        <SessionHeader {...defaultProps} lastUpdatedBy="Jane Smith" />
      )
      expect(container).toMatchSnapshot()
    })

    test('matches snapshot with no active item', () => {
      const { container } = render(
        <SessionHeader
          {...defaultProps}
          activeRoomLabel={null}
          activeItemLabel={null}
        />
      )
      expect(container).toMatchSnapshot()
    })
  })
})
