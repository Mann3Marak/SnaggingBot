import type { Meta, StoryObj } from '@storybook/react'
import { SessionHeader, StatusCounts } from './SessionHeader'

/**
 * SessionHeader Component Stories
 *
 * Reusable header displaying:
 * - Session metadata (project, apartment, inspector)
 * - Progress summary with circular progress indicator
 * - Status chips showing item counts
 * - Active item display
 * - Last updated timestamp
 *
 * To enable these stories:
 * 1. Install Storybook: npm install --save-dev @storybook/react @storybook/nextjs
 * 2. Rename this file to SessionHeader.stories.tsx
 * 3. Run: npm run storybook
 */

const meta = {
  title: 'Inspection/SessionHeader',
  component: SessionHeader,
  parameters: {
    layout: 'fullscreen',
  },
  tags: ['autodocs'],
} satisfies Meta<typeof SessionHeader>

export default meta
type Story = StoryObj<typeof meta>

// ==================== MOCK DATA ====================

const mockCountsInProgress: StatusCounts = {
  good: 15,
  issue: 3,
  critical: 1,
  skipped: 2,
  notApplicable: 4,
  pending: 10,
}

const mockCountsComplete: StatusCounts = {
  good: 28,
  issue: 5,
  critical: 2,
  skipped: 0,
  notApplicable: 3,
  pending: 0,
}

const mockCountsEarly: StatusCounts = {
  good: 2,
  issue: 0,
  critical: 0,
  skipped: 0,
  notApplicable: 0,
  pending: 48,
}

const mockCountsCritical: StatusCounts = {
  good: 10,
  issue: 8,
  critical: 7,
  skipped: 1,
  notApplicable: 2,
  pending: 12,
}

